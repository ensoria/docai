  "operationContracts": {
    "r-csv-operation": {
      "purpose": "Sends one lifecycle record through the publication-scoped CSV wire adapter."
    },
    "r-json-original-operation": {
      "purpose": "Publishes the canonical lifecycle record used by the compact reuse example."
    },
    "r-json-reuse-operation": {
      "purpose": "Publishes the same lifecycle record through a second operation."
    },
    "r-raw-operation": {
      "purpose": "Sends an authoritatively opaque receipt payload."
    },
    "r-tagged-operation": {
      "purpose": "Sends a lifecycle event selected by its complete discriminator mapping."
    },
    "r-untagged-operation": {
      "purpose": "Receives a lifecycle event selected without a discriminator field."
    }
  }
