    {
      "id": "complete-checkout-workflow",
      "class": "workflow_completion",
      "profile": "compact",
      "public": {
        "user_task": "Complete checkout for cart_01K0COMPLETE with a card payment for JPY 1200. Explain the ordered calls, values and idempotency keys to retain, recovery after an ambiguous order result, and reconciliation when payment.completed arrives before the order is confirmed.",
        "output_contract": "workflow-completion.v1",
        "retrieval": {
          "openapi_roots": [
            "paths./carts/{id}/validate.post",
            "paths./payments.post",
            "paths./orders.post",
            "webhooks.payment.completed",
            "x-docai-workflows.checkout"
          ],
          "docai_files": [
            "INDEX.md",
            "CONVENTIONS.md",
            "resources/checkout.md",
            "resources/payments.md",
            "workflows/checkout.md",
            "webhooks/payment-completed.md"
          ]
        }
      },
      "private": {
        "expected_outcome": {
          "steps": [
            {
              "order": 1,
              "method": "POST",
              "path": "/v1/carts/cart_01K0COMPLETE/validate",
              "input": {
                "id": "cart_01K0COMPLETE"
              },
              "keep": [
                "cart_id"
              ],
              "state_after_success": "cart.validated"
            },
            {
              "order": 2,
              "method": "POST",
              "path": "/v1/payments",
              "input": {
                "cart_id": "cart_01K0COMPLETE",
                "amount": 1200,
                "currency": "JPY",
                "type": "card",
                "card_token": "<card-token>",
                "Idempotency-Key": "<payment-operation-key>"
              },
              "keep": [
                "payment_id",
                "Idempotency-Key"
              ],
              "state_after_success": "payment.pending + order.not_confirmed"
            },
            {
              "order": 3,
              "method": "POST",
              "path": "/v1/orders",
              "input": {
                "cart_id": "cart_01K0COMPLETE",
                "payment_id": "<payment_id>",
                "Idempotency-Key": "<order-operation-key>"
              },
              "keep": [
                "order_id",
                "cart_id",
                "payment_id",
                "Idempotency-Key"
              ],
              "state_after_success": "payment.settled + order.confirmed"
            }
          ],
          "failure_recovery": [
            "For an ambiguous or safely retryable POST /orders outcome, preserve payment state and replay the same cart_id, payment_id, and Idempotency-Key.",
            "If payment is already settled, POST /orders associates it without another capture."
          ],
          "webhook_reconciliation": [
            "Match payment.completed by payment_id.",
            "Record payment.settled + order.not_confirmed and continue POST /orders without another capture."
          ],
          "uncertainties": []
        },
        "assertions": [
          {
            "path": "/steps",
            "operator": "contains",
            "value": [
              {
                "order": 1,
                "method": "POST",
                "path": "/v1/carts/cart_01K0COMPLETE/validate",
                "state_after_success": "cart.validated"
              },
              {
                "order": 2,
                "method": "POST",
                "path": "/v1/payments",
                "state_after_success": "payment.pending + order.not_confirmed"
              },
              {
                "order": 3,
                "method": "POST",
                "path": "/v1/orders",
                "state_after_success": "payment.settled + order.confirmed"
              }
            ],
            "failure_category": "workflow-steps"
          },
          {
            "path": "/failure_recovery",
            "operator": "contains",
            "value": [
              "For an ambiguous or safely retryable POST /orders outcome, preserve payment state and replay the same cart_id, payment_id, and Idempotency-Key.",
              "If payment is already settled, POST /orders associates it without another capture."
            ],
            "failure_category": "workflow-recovery"
          },
          {
            "path": "/webhook_reconciliation",
            "operator": "contains",
            "value": [
              "Match payment.completed by payment_id.",
              "Record payment.settled + order.not_confirmed and continue POST /orders without another capture."
            ],
            "failure_category": "workflow-webhook"
          }
        ],
        "fact_inventory": {
          "required": [
            "checkout:ordered-steps",
            "checkout:state-transitions",
            "checkout:payment-idempotency",
            "checkout:order-idempotency",
            "checkout:order-recovery",
            "checkout:early-webhook",
            "checkout:no-double-capture"
          ],
          "raw_missing": [
            "checkout:state-transitions",
            "checkout:payment-idempotency",
            "checkout:order-idempotency",
            "checkout:order-recovery",
            "checkout:early-webhook",
            "checkout:no-double-capture"
          ],
          "sliced_missing": [
            "checkout:state-transitions",
            "checkout:payment-idempotency",
            "checkout:order-idempotency",
            "checkout:order-recovery",
            "checkout:early-webhook",
            "checkout:no-double-capture"
          ]
        }
      }
