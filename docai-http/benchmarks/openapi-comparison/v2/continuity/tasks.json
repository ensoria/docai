    {
      "id": "payment-completed-webhook",
      "class": "webhook_handling",
      "profile": "compact",
      "public": {
        "user_task": "Implement a receiver for payment.completed. Describe the HTTP delivery, required header and payload handling, acknowledgement deadline, duplicate handling, opaque metadata treatment, and reconciliation with checkout when the event arrives early.",
        "output_contract": "webhook-handling.v1",
        "retrieval": {
          "openapi_roots": [
            "webhooks.payment.completed",
            "paths./payments.post",
            "x-docai-workflows.checkout"
          ],
          "docai_files": [
            "INDEX.md",
            "CONVENTIONS.md",
            "resources/payments.md",
            "workflows/checkout.md",
            "webhooks/payment-completed.md"
          ]
        }
      },
      "private": {
        "expected_outcome": {
          "webhook": {
            "event": "payment.completed",
            "method": "POST",
            "path": "<registered URL>",
            "verification": [
              "Read the required X-Payment-Attempt single field line.",
              "Treat deliveries as at-least-once and unordered.",
              "Deduplicate by event_id."
            ],
            "headers": {
              "X-Payment-Attempt": "<required string; not comma-combinable>"
            },
            "payload": {
              "required": [
                "event_id",
                "event",
                "payment_id",
                "amount",
                "occurred_at",
                "metadata"
              ],
              "metadata": "opaque; store or forward without interpreting"
            },
            "acknowledgement": {
              "status": "any 2xx",
              "deadline": "within 5 seconds"
            },
            "reconciliation": [
              "Match by payment_id.",
              "If early, record payment.settled + order.not_confirmed.",
              "Continue POST /orders without capturing the settled payment again."
            ]
          },
          "uncertainties": []
        },
        "assertions": [
          {
            "path": "/webhook",
            "operator": "contains",
            "value": {
              "event": "payment.completed",
              "method": "POST",
              "headers": {
                "X-Payment-Attempt": "<required string; not comma-combinable>"
              },
              "acknowledgement": {
                "status": "any 2xx",
                "deadline": "within 5 seconds"
              }
            },
            "failure_category": "webhook-delivery"
          },
          {
            "path": "/webhook/verification",
            "operator": "contains",
            "value": [
              "Treat deliveries as at-least-once and unordered.",
              "Deduplicate by event_id."
            ],
            "failure_category": "webhook-deduplication"
          },
          {
            "path": "/webhook/payload",
            "operator": "contains",
            "value": {
              "metadata": "opaque; store or forward without interpreting"
            },
            "failure_category": "webhook-payload"
          },
          {
            "path": "/webhook/reconciliation",
            "operator": "contains",
            "value": [
              "Match by payment_id.",
              "If early, record payment.settled + order.not_confirmed.",
              "Continue POST /orders without capturing the settled payment again."
            ],
            "failure_category": "webhook-reconciliation"
          }
        ],
        "fact_inventory": {
          "required": [
            "webhook:payment-method",
            "webhook:payment-attempt-header",
            "webhook:payment-payload",
            "webhook:at-least-once-unordered",
            "webhook:deduplicate-event-id",
            "webhook:ack-2xx-five-seconds",
            "webhook:opaque-metadata",
            "checkout:early-webhook",
            "checkout:no-double-capture"
          ],
          "raw_missing": [
            "webhook:at-least-once-unordered",
            "webhook:deduplicate-event-id",
            "webhook:ack-2xx-five-seconds",
            "checkout:early-webhook",
            "checkout:no-double-capture"
          ],
          "sliced_missing": [
            "webhook:at-least-once-unordered",
            "webhook:deduplicate-event-id",
            "webhook:ack-2xx-five-seconds",
            "checkout:early-webhook",
            "checkout:no-double-capture"
          ]
        }
      }
    }
