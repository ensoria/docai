    {
      "id": "create-user-errors",
      "class": "error_recovery",
      "profile": "compact",
      "public": {
        "user_task": "Design error handling for creating a user when the email is already used, validation fails, the idempotency key conflicts, or the access token has expired. State whether and how each case may be retried.",
        "output_contract": "error-recovery.v3",
        "retrieval": {
          "openapi_roots": [
            "paths./users.post",
            "components.responses.ValidationError",
            "components.responses.TokenExpired",
            "components.schemas.EmailTakenError",
            "components.schemas.StandardError",
            "components.schemas.ValidationError"
          ],
          "docai_files": [
            "INDEX.md",
            "CONVENTIONS.md",
            "resources/users.md"
          ]
        }
      },
      "private": {
        "expected_outcome": {
          "errors": [
            {
              "status": 409,
              "code": "email_taken",
              "retry_policy": "after-correction-with-new-key",
              "caller_action": "Use another email address and a new idempotency key; do not retry unchanged input.",
              "preserve": []
            },
            {
              "status": 422,
              "code": "validation_failed",
              "retry_policy": "after-correction-with-new-key",
              "caller_action": "Correct the input, then retry as a new logical operation with a new idempotency key.",
              "preserve": []
            },
            {
              "status": 409,
              "code": "idempotency_conflict",
              "retry_policy": "original-request-or-new-logical-operation",
              "caller_action": "Use the original request or a new key for a new logical operation; do not reuse the conflicting key with changed input.",
              "preserve": []
            },
            {
              "status": 401,
              "code": "token_expired",
              "retry_policy": "once-after-token-refresh-with-same-request-and-key",
              "caller_action": "Refresh once, then retry once.",
              "preserve": [
                "semantically identical request",
                "Idempotency-Key"
              ]
            }
          ],
          "uncertainties": []
        },
        "assertions": [
          {
            "path": "/errors",
            "operator": "contains",
            "value": [
              {
                "status": 409,
                "code": "email_taken",
                "retry_policy": "after-correction-with-new-key"
              }
            ],
            "failure_category": "error-email-taken",
            "fact_id": "users:email-taken-action"
          },
          {
            "path": "/errors",
            "operator": "contains",
            "value": [
              {
                "status": 422,
                "code": "validation_failed",
                "retry_policy": "after-correction-with-new-key"
              }
            ],
            "failure_category": "error-validation",
            "fact_id": "users:validation-action"
          },
          {
            "path": "/errors",
            "operator": "contains",
            "value": [
              {
                "status": 409,
                "code": "idempotency_conflict",
                "retry_policy": "original-request-or-new-logical-operation"
              }
            ],
            "failure_category": "error-idempotency-conflict",
            "fact_id": "common:idempotency-conflict-action"
          },
          {
            "path": "/errors",
            "operator": "contains",
            "value": [
              {
                "status": 401,
                "code": "token_expired",
                "retry_policy": "once-after-token-refresh-with-same-request-and-key"
              }
            ],
            "failure_category": "error-token-expired",
            "fact_id": "common:token-expired-action"
          },
          {
            "path": "/errors",
            "operator": "contains",
            "value": [
              {
                "code": "token_expired",
                "preserve": [
                  "semantically identical request",
                  "Idempotency-Key"
                ]
              }
            ],
            "failure_category": "error-token-preservation",
            "fact_id": "common:create-idempotency"
          }
        ],
        "fact_inventory": {
          "required": [
            "users:email-taken-action",
            "users:validation-action",
            "common:idempotency-conflict-action",
            "common:token-expired-action",
            "common:create-idempotency"
