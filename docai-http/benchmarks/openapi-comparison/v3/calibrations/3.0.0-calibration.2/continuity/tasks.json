    {
      "id": "complete-checkout-workflow",
      "class": "workflow_completion",
      "profile": "compact",
      "public": {
        "user_task": "Complete checkout for cart_01K0COMPLETE with a card payment for JPY 1200. Explain the ordered calls, values and idempotency keys to retain, recovery after an ambiguous order result, and reconciliation when payment.completed arrives before the order is confirmed.",
        "output_contract": "workflow-completion.v3",
        "retrieval": {
          "openapi_roots": [
            "paths./carts/{id}/validate.post",
            "paths./payments.post",
            "paths./orders.post",
            "webhooks.payment.completed",
            "x-docai-workflows.checkout"
          ],
          "docai_files": [
            "INDEX.md",
            "CONVENTIONS.md",
            "resources/checkout.md",
            "resources/payments.md",
            "workflows/checkout.md",
            "webhooks/payment-completed.md"
          ]
        }
      },
      "private": {
        "expected_outcome": {
          "steps": [
            {
              "order": 1,
              "method": "POST",
              "path": "/v1/carts/cart_01K0COMPLETE/validate",
              "input": {
                "id": "cart_01K0COMPLETE"
              },
              "keep": [
                "cart_id"
              ],
              "states_after_success": [
                "cart.validated"
              ]
            },
            {
              "order": 2,
              "method": "POST",
              "path": "/v1/payments",
              "input": {
                "cart_id": "cart_01K0COMPLETE",
                "amount": 1200,
                "currency": "JPY",
                "type": "card",
                "card_token": "<card-token>",
                "Idempotency-Key": "<payment-operation-key>"
              },
              "keep": [
                "payment_id",
                "Idempotency-Key"
              ],
              "states_after_success": [
                "payment.pending",
                "order.not_confirmed"
              ]
            },
            {
              "order": 3,
              "method": "POST",
              "path": "/v1/orders",
              "input": {
                "cart_id": "cart_01K0COMPLETE",
                "payment_id": "<payment_id>",
                "Idempotency-Key": "<order-operation-key>"
              },
              "keep": [
                "order_id",
                "cart_id",
                "payment_id",
                "Idempotency-Key"
              ],
              "states_after_success": [
                "payment.settled",
                "order.confirmed"
              ]
            }
          ],
          "failure_recovery": [
            {
              "case": "ambiguous/retryable POST /orders",
              "action": "same-request-and-key",
              "preserve": [
                "cart_id",
                "payment_id",
                "Idempotency-Key"
              ],
              "repeat_side_effect": false
            },
            {
              "case": "already-settled payment",
              "action": "continue-without-recapture",
              "preserve": [
                "payment_id"
              ],
              "repeat_side_effect": false
            }
          ],
          "webhook_reconciliation": [
            {
              "event": "payment.completed",
              "match_by": [
                "payment_id"
              ],
              "record_states": [
                "payment.settled",
                "order.not_confirmed"
              ],
              "continue_operation": "POST /orders",
              "repeat_side_effect": false
            }
          ],
          "uncertainties": []
        },
        "assertions": [
          {
            "path": "/steps",
            "operator": "contains",
            "value": [
              {
                "order": 1,
                "method": "POST",
                "path": "/v1/carts/cart_01K0COMPLETE/validate"
              },
              {
                "order": 2,
                "method": "POST",
                "path": "/v1/payments"
              },
              {
                "order": 3,
                "method": "POST",
                "path": "/v1/orders"
              }
            ],
            "failure_category": "workflow-steps",
            "fact_id": "checkout:ordered-steps"
          },
          {
            "path": "/steps",
            "operator": "contains",
            "value": [
              {
                "order": 1,
                "states_after_success": [
                  "cart.validated"
                ]
              },
              {
                "order": 2,
                "states_after_success": [
                  "payment.pending",
                  "order.not_confirmed"
                ]
              },
              {
                "order": 3,
                "states_after_success": [
                  "payment.settled",
                  "order.confirmed"
                ]
              }
            ],
            "failure_category": "workflow-states",
            "fact_id": "checkout:state-transitions"
          },
          {
            "path": "/steps",
            "operator": "contains",
            "value": [
              {
                "order": 2,
                "input": {
                  "Idempotency-Key": "<payment-operation-key>"
                },
                "keep": [
                  "payment_id",
                  "Idempotency-Key"
                ]
              }
            ],
            "failure_category": "workflow-payment-idempotency",
            "fact_id": "checkout:payment-idempotency"
          },
          {
            "path": "/steps",
            "operator": "contains",
            "value": [
              {
                "order": 3,
                "input": {
                  "cart_id": "cart_01K0COMPLETE",
                  "payment_id": "<payment_id>",
                  "Idempotency-Key": "<order-operation-key>"
                }
              }
            ],
            "failure_category": "workflow-order-idempotency",
            "fact_id": "checkout:order-idempotency"
          },
          {
