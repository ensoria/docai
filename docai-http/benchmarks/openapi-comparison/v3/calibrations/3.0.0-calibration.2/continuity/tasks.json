          },
          {
            "path": "/failure_recovery",
            "operator": "contains",
            "value": [
              {
                "case": "already-settled payment",
                "action": "continue-without-recapture",
                "preserve": [
                  "payment_id"
                ],
                "repeat_side_effect": false
              }
            ],
            "failure_category": "workflow-no-double-capture",
            "fact_id": "checkout:no-double-capture"
          },
          {
            "path": "/webhook_reconciliation",
            "operator": "contains",
            "value": [
              {
                "event": "payment.completed",
                "match_by": [
                  "payment_id"
                ],
                "record_states": [
                  "payment.settled",
                  "order.not_confirmed"
                ],
                "continue_operation": "POST /orders"
              }
            ],
            "failure_category": "workflow-webhook",
            "fact_id": "checkout:early-webhook"
          },
          {
            "path": "/webhook_reconciliation",
            "operator": "contains",
            "value": [
              {
                "event": "payment.completed",
                "repeat_side_effect": false
              }
            ],
            "failure_category": "workflow-no-double-capture",
            "fact_id": "checkout:no-double-capture"
          }
        ],
        "fact_inventory": {
          "required": [
            "checkout:ordered-steps",
            "checkout:state-transitions",
            "checkout:payment-idempotency",
            "checkout:order-idempotency",
            "checkout:order-recovery",
            "checkout:early-webhook",
            "checkout:no-double-capture"
          ],
          "raw_missing": [
            "checkout:state-transitions",
            "checkout:payment-idempotency",
            "checkout:order-idempotency",
            "checkout:order-recovery",
            "checkout:early-webhook",
            "checkout:no-double-capture"
          ],
